---
import Layout from "../layouts/Layout.astro";
import Seo from "../components/Seo.astro";
import { STATES } from "../data/states";
import { isUnverified } from "../data/schema";
import { capLabel, channelLabel } from "../data/format";

function cell(f, render) {
  if (isUnverified(f)) return "—";
  const v = f.value;
  return render ? render(v) : String(v);
}
---
<Layout>
  <Seo
    slot="head"
    title="Compare Cottage Food Laws Across U.S. States"
    description="Side-by-side comparison of cottage food laws: permits, sales caps, online sales, training, and inspections."
    path="/compare/"
  />

  <div class="container-prose py-10">
    <h1 class="font-serif text-3xl md:text-4xl">Compare U.S. Cottage Food Laws</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      A side-by-side comparison of the cottage food rules in covered states. Click a state name
      for the full sourced page.
    </p>
    <div class="mt-6 overflow-x-auto rounded border border-border">
      <table class="w-full min-w-[800px] border-collapse text-sm">
        <thead>
          <tr class="bg-muted text-left">
            <th class="px-3 py-2 font-serif text-sm font-semibold">State</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Permit</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">License cost</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Annual sales cap</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Online (in-state)</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Out-of-state shipping</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Training</th>
            <th class="px-3 py-2 font-serif text-sm font-semibold">Inspection</th>
          </tr>
        </thead>
        <tbody>
          {STATES.map((s) => {
            const ch = isUnverified(s.sales_channels) ? null : s.sales_channels.value;
            return (
              <tr class="border-t border-rule align-top">
                <td class="px-3 py-3">
                  <a href={`/states/${s.slug}/`} class="font-medium no-underline">{s.name}</a>
                  <div class="citation">/{s.abbreviation}</div>
                </td>
                <td class="px-3 py-3">{cell(s.permit_required, (v) => (v ? "Yes" : "No"))}</td>
                <td class="px-3 py-3">
                  {cell(s.license_cost_usd, (v) =>
                    v === "none" ? "None" : v === "varies" ? "Varies" : `$${v.toLocaleString()}`,
                  )}
                </td>
                <td class="px-3 py-3">
                  {cell(s.sales_cap_usd_annual, capLabel)}
                </td>
                <td class="px-3 py-3">{ch ? channelLabel(ch.online_in_state) : "—"}</td>
                <td class="px-3 py-3">{ch ? channelLabel(ch.online_out_of_state) : "—"}</td>
                <td class="px-3 py-3">{cell(s.training_required, (v) => (v ? "Yes" : "No"))}</td>
                <td class="px-3 py-3">{cell(s.inspection_required, (v) => (v ? "Yes" : "No"))}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="citation mt-4">"—" indicates a field that has not been verified yet.</p>
  </div>
</Layout>
