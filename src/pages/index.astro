---
import Layout from "../layouts/Layout.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { STATES } from "../data/states";
import { FOODS } from "../data/foods";

const site = "https://cottagefoodmap.com";
const title = "Cottage Food Law /US — Sourced Home-Food Rules by State";
// State count comes from the data, so it stays true as states are added (v2: 20, v3: all 50).
const description =
  `Permits, sales caps, allowed foods, labeling, and sales channels for cottage food operations in ${STATES.length} U.S. states so far, with the rest being added. Every fact links to an official source.`;
const shortDescription = `Sourced home-food rules for ${STATES.length} U.S. states so far, with more being added.`;
---
<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + "/"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cottage Food Law /US" />
    <meta property="og:description" content={shortDescription} />
    <meta property="og:url" content={site + "/"} />
    <meta property="og:site_name" content="Cottage Food Law /US" />

    <meta name="twitter:title" content="Cottage Food Law /US" />
    <meta name="twitter:description" content={shortDescription} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://cottagefoodmap.com/#organization",
          name: "Cottage Food Law /US",
          url: "https://cottagefoodmap.com/",
        },
        {
          "@type": "WebSite",
          "@id": "https://cottagefoodmap.com/#website",
          url: "https://cottagefoodmap.com/",
          name: "Cottage Food Law /US",
          description: "Structured, sourced reference to U.S. cottage food laws.",
          publisher: { "@id": "https://cottagefoodmap.com/#organization" },
        },
      ],
    })} />
  </Fragment>

  <div class="container-prose py-10 md:py-14">
    <div class="max-w-3xl">
      <p class="citation mb-3">A structured legal reference · {STATES.length} states covered</p>
      <h1 class="font-serif text-4xl leading-tight md:text-5xl">
        Cottage food laws, citation by citation.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        A free, sourced reference to U.S. cottage food laws — permits, sales caps, allowed and
        prohibited foods, labeling rules, and sales channels. Every fact links to the state
        agency, statute, or official PDF it came from, with a verification date.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/states/" class="rounded border border-primary bg-primary px-4 py-2 text-sm font-medium text-primary-foreground no-underline hover:no-underline">
          Browse states
        </a>
        <a href="/compare/" class="rounded border border-border bg-background px-4 py-2 text-sm font-medium text-foreground no-underline hover:bg-muted">
          Compare side by side
        </a>
      </div>
      <div class="mt-6"><Disclaimer /></div>
    </div>

    <div class="double-rule mt-12 pt-8"></div>

    <section>
      <h2 class="font-serif text-2xl">States covered</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm md:grid-cols-3">
        {STATES.map((s) => (
          <li>
            <a href={`/states/${s.slug}/`} class="no-underline">
              {s.name} <span class="citation">/{s.abbreviation}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl">By food category</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm md:grid-cols-3">
        {FOODS.map((f) => (
          <li>
            <a href={`/foods/${f.slug}/`} class="no-underline">{f.name}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl">How to use this site</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed">
        <li>Open your state page for the full rule set with citations.</li>
        <li>Use the comparison table to see how requirements differ across states.</li>
        <li>Open a food category page to see where that food is allowed or prohibited.</li>
        <li>Read the cited source. This site does not replace primary sources or legal advice.</li>
      </ol>
    </section>
  </div>
</Layout>
