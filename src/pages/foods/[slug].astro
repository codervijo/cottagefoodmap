---
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/Seo.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import Cite from "../../components/guide/Cite.astro";
import CitedList from "../../components/guide/CitedList.astro";
import { FOODS, STATUS_ANSWER, foodMatches, statusForFood } from "../../data/foods";
import { STATES } from "../../data/states";
import { isUnverified } from "../../data/schema";
import { overrideStatement } from "../../data/guide";

export function getStaticPaths() {
  return FOODS.map((food) => ({ params: { slug: food.slug }, props: { food } }));
}

const { food } = Astro.props;
const rows = STATES.map((s) => ({
  state: s,
  status: statusForFood(s, food),
  matches: foodMatches(s, food),
  override: overrideStatement(s, food),
}));
const count = (st: string) => rows.filter((r) => r.status === st).length;
const foodName = food.name.toLowerCase();
---
<Layout>
  <Seo
    slot="head"
    title={`${food.name} as a Cottage Food — Where It's Allowed`}
    description={`Where you can legally sell ${food.name.toLowerCase()} as a cottage food. State-by-state status with sources.`}
    path={`/foods/${food.slug}/`}
    crumb={food.name}
    ogType="article"
  />

  <article class="container-prose py-10">
    <p class="citation">Food category</p>
    <h1 class="font-serif text-4xl">{food.name}</h1>
    <p class="mt-2 max-w-2xl text-lg text-muted-foreground">{food.description}</p>
    <div class="mt-4"><Disclaimer /></div>

    <div class="double-rule mt-8 pt-6"></div>

    <h2 class="font-serif text-xl">Status by state</h2>
    <ul class="mt-4 divide-y divide-rule border-y border-rule">
      {rows.map(({ state, status }) => (
        <li class="flex flex-wrap items-center justify-between gap-2 py-3">
          <a href={`/states/${state.slug}/`} class="no-underline">
            <span class="font-serif text-base text-foreground">{state.name}</span>{" "}
            <span class="citation">/{state.abbreviation}</span>
          </a>
          <span
            class={`badge-chip ${
              status === "allowed" ? "badge-yes" : status === "prohibited" ? "badge-no" : "badge-unverified"
            }`}
          >
            {status === "allowed" ? "Allowed" : status === "restricted" ? "Allowed with limits" : status === "prohibited" ? "Prohibited" : "Unclear"}
          </span>
        </li>
      ))}
    </ul>
    <p class="citation mt-4">
      Status comes from each state's allowed and prohibited lists, or from the state's own guidance
      where the lists don't settle it. "Allowed with limits" means the state allows some products in
      this category but not others. "Unclear" means the cited sources don't say either way.
    </p>

    <p class="mt-6">
      Of the {rows.length} states covered, {count("allowed")} allow {foodName}, {count("restricted")} allow it with limits,
      {count("prohibited")} prohibit it, and in {count("unclear")} the official sources don't settle it.
    </p>

    <h2 class="mt-10 font-serif text-xl">What each state's lists say</h2>
    {rows.map(({ state, status, matches, override }) => (
      <section class="mt-6">
        <h3 class="font-serif text-lg">
          <a href={`/guides/sell/${food.slug}/${state.slug}/`}>{state.name}: {STATUS_ANSWER[status]}</a>
        </h3>
        {override && <CitedList items={[override]} />}
        {!override && matches.allowed.length > 0 && !isUnverified(state.allowed_foods) && (
          <div class="mt-2 text-sm">
            <p>Allowed list:</p>
            <ul class="list-disc pl-5">{matches.allowed.map((i) => <li>{i}</li>)}</ul>
            <Cite cite={state.allowed_foods} />
          </div>
        )}
        {!override && matches.prohibited.length > 0 && !isUnverified(state.prohibited_foods) && (
          <div class="mt-2 text-sm">
            <p>Prohibited list:</p>
            <ul class="list-disc pl-5">{matches.prohibited.map((i) => <li>{i}</li>)}</ul>
            <Cite cite={state.prohibited_foods} />
          </div>
        )}
        {!override && matches.allowed.length === 0 && matches.prohibited.length === 0 && (
          <p class="mt-2 text-sm">
            {status === "allowed" && !isUnverified(state.allowed_foods)
              ? <>{state.name} allows any cottage food not on its prohibited list, and no {foodName} item is on it. <Cite cite={state.allowed_foods} /></>
              : <>Neither {state.name} list names {foodName}.{!isUnverified(state.allowed_foods) && <> <Cite cite={state.allowed_foods} /></>}</>}
          </p>
        )}
      </section>
    ))}

    <div class="mt-10">
      <h2 class="font-serif text-xl">Related categories</h2>
      <ul class="mt-3 grid grid-cols-2 gap-2 text-sm md:grid-cols-3">
        {FOODS.filter((f) => f.slug !== food.slug).map((f) => (
          <li>
            <a href={`/foods/${f.slug}/`}>{f.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </article>
</Layout>
