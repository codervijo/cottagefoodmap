---
import Layout from "../../../layouts/Layout.astro";
import Seo from "../../../components/Seo.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import CitedList from "../../../components/guide/CitedList.astro";
import QaSection from "../../../components/guide/QaSection.astro";
import { STATES } from "../../../data/states";
import { FOODS } from "../../../data/foods";
import { isUnverified } from "../../../data/schema";
import { costTitle, joinPhrases, permitPhrase } from "../../../data/phrases";
import {
  capDetail, capStatements, compact, costStatement, factNotes, inspectionStatement,
  permitStatement, trainingStatement, type QA,
} from "../../../data/guide";

export function getStaticPaths() {
  return STATES.map((state) => ({ params: { state: state.slug }, props: { state } }));
}

const { state } = Astro.props;
const cost = state.license_cost_usd;
const answer = costStatement(state);
const titleAnswer = costTitle(state);

const permitDetails = state.permit_details;
const qas: QA[] = [
  {
    q: `Does ${state.name} require a cottage food permit?`,
    a: compact([
      permitStatement(state),
      factNotes(state.permit_required),
      isUnverified(permitDetails) ? null : { text: permitDetails.value, cite: permitDetails },
      factNotes(permitDetails),
    ]),
  },
  {
    q: `Do I need training or a home inspection in ${state.name}?`,
    a: compact([
      trainingStatement(state),
      factNotes(state.training_required),
      inspectionStatement(state),
      factNotes(state.inspection_required),
    ]),
  },
  { q: `Is there a sales cap in ${state.name}?`, a: [...capStatements(state), ...capDetail(state)] },
];

// Fee comparison across every covered state, each row cited to its own source.
const feeLabel = (v: number | "none" | "varies") =>
  v === "none" ? "No state fee" : v === "varies" ? "Set locally" : v === 0 ? "Free" : `$${v.toLocaleString("en-US")}`;
const rows = STATES.map((s) => ({ state: s, cost: s.license_cost_usd }));
const verified = rows.filter((r) => !isUnverified(r.cost));
const noFee = verified.filter((r) => !isUnverified(r.cost) && (r.cost.value === "none" || r.cost.value === 0)).length;
const local = verified.filter((r) => !isUnverified(r.cost) && r.cost.value === "varies").length;
const charged = verified.length - noFee - local;
---
<Layout>
  <Seo
    slot="head"
    title={`Cottage Food License Cost in ${state.name}${titleAnswer ? `: ${titleAnswer}` : ""}`}
    description={`${answer?.text ?? "Unverified."} ${joinPhrases([permitPhrase(state)])} Sourced to the official state agency.`}
    path={`/guides/license-cost/${state.slug}/`}
    crumb={`License cost in ${state.name}`}
    ogType="article"
  />

  <article class="container-prose py-10">
    <p class="citation">Guide · License cost</p>
    <h1 class="font-serif text-3xl md:text-4xl">Cottage food license cost in {state.name}</h1>
    <div class="mt-3"><Disclaimer /></div>

    {answer ? (
      <div class="text-lg">
        <CitedList items={compact([answer, factNotes(cost)])} />
      </div>
    ) : (
      <p class="mt-6 text-lg">No verified fee yet. Check the official {state.name} agency.</p>
    )}

    <QaSection heading={`What else ${state.name} requires`} qas={qas} />

    <section class="mt-10">
      <h2 class="font-serif text-2xl">Cottage food fees in other states</h2>
      <p class="mt-3">
        Of the {verified.length} states this site covers, including {state.name}, {noFee} charge no state fee, {charged} charge one, and {local} leave fees to local governments.
      </p>
      <table class="mt-4 w-full text-left text-sm">
        <thead>
          <tr class="border-b border-rule">
            <th class="py-2 pr-4 font-medium">State</th>
            <th class="py-2 pr-4 font-medium">State fee</th>
            <th class="py-2 font-medium">Source</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-rule align-top">
              <td class="py-2 pr-4">
                {r.state.slug === state.slug
                  ? <strong>{r.state.name}</strong>
                  : <a href={`/guides/license-cost/${r.state.slug}/`}>{r.state.name}</a>}
              </td>
              <td class="py-2 pr-4">{isUnverified(r.cost) ? "Unverified" : feeLabel(r.cost.value)}</td>
              <td class="py-2">
                {!isUnverified(r.cost) && (
                  <a class="citation" href={r.cost.source_url} target="_blank" rel="noopener noreferrer">
                    {r.cost.source_title ?? r.cost.source_url}
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl">What you can sell in {state.name}</h2>
      <ul class="mt-3 grid grid-cols-1 gap-2 text-sm md:grid-cols-2">
        {FOODS.map((f) => (
          <li><a href={`/guides/sell/${f.slug}/${state.slug}/`}>Selling {f.name.toLowerCase()} in {state.name}</a></li>
        ))}
      </ul>
    </section>

    <nav class="double-rule mt-10 pt-6 text-sm" aria-label="Related">
      <ul class="space-y-1">
        <li>All {state.name} rules: <a href={`/states/${state.slug}/`}>{state.name} cottage food law</a></li>
        <li>Labels: <a href={`/guides/labeling/${state.slug}/`}>{state.name} labeling requirements</a></li>
        <li>All guides: <a href="/guides/">Cottage food guides</a></li>
      </ul>
    </nav>
  </article>
</Layout>
