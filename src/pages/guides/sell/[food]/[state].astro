---
import Layout from "../../../../layouts/Layout.astro";
import Seo from "../../../../components/Seo.astro";
import Disclaimer from "../../../../components/Disclaimer.astro";
import Cite from "../../../../components/guide/Cite.astro";
import CitedList from "../../../../components/guide/CitedList.astro";
import QaSection from "../../../../components/guide/QaSection.astro";
import { STATES } from "../../../../data/states";
import { FOODS, STATUS_ANSWER, foodMatches, statusForFood } from "../../../../data/foods";
import { isUnverified } from "../../../../data/schema";
import { capPhrase, costPhrase, joinPhrases, permitPhrase } from "../../../../data/phrases";
import {
  agencyStatement, capStatements, channelNotes, channelStatement, compact, costStatement,
  factNotes, foodLabelLines, foodNotes, inspectionStatement, overrideStatement, permitStatement,
  trainingStatement, type QA,
} from "../../../../data/guide";

export function getStaticPaths() {
  return FOODS.flatMap((food) =>
    STATES.map((state) => ({
      params: { food: food.slug, state: state.slug },
      props: { food, state },
    })),
  );
}

const { food, state } = Astro.props;
const status = statusForFood(state, food);
const matches = foodMatches(state, food);
const override = overrideStatement(state, food);
const foodName = food.name.toLowerCase();

const headline =
  status === "allowed"
    ? `Yes — ${foodName} is allowed under ${state.name} cottage food law.`
    : status === "restricted"
      ? `Yes, with limits — ${state.name} allows some ${foodName} but prohibits others.`
      : status === "prohibited"
        ? `No — ${foodName} is not allowed under ${state.name} cottage food law.`
        : `It's unclear from ${state.name}'s official list. Confirm with the state agency before producing.`;

// What the status label means on this page, in terms of this state's lists.
const statusBasis = override
  ? `This answer comes from ${state.name}'s official guidance on ${foodName}, summarized below, rather than from its food lists alone.`
  : status === "restricted"
    ? `"With limits" means ${state.name}'s allowed list and its prohibited list both name ${foodName} items. Check which list your product is on.`
    : status === "prohibited"
      ? `${state.name}'s prohibited list names ${foodName} items, and its allowed list does not.`
      : status === "unclear"
        ? `${food.name} is not named on ${state.name}'s allowed or prohibited list.`
        : state.allows_all_except_prohibited && matches.allowed.length === 0
          ? `${state.name} allows any cottage food that isn't on its prohibited list, and no ${foodName} item is on that list.`
          : `${state.name}'s allowed list names ${foodName} items, and its prohibited list does not.`;

const shortAnswer =
  status === "allowed"
    ? `${state.name} allows ${foodName} as a cottage food.`
    : status === "restricted"
      ? `${state.name} allows some ${foodName} but prohibits others.`
      : status === "prohibited"
        ? `${state.name} does not allow ${foodName} as a cottage food.`
        : `${food.name} isn't named in ${state.name}'s official list.`;

const rules = status === "allowed" || status === "restricted"
  ? joinPhrases([permitPhrase(state), costPhrase(state), capPhrase(state)])
  : "";

const allowedFact = state.allowed_foods;
// States that allow any food except a prohibited list have no per-food allowed item;
// show the rule itself instead.
const allowedItems =
  matches.allowed.length > 0
    ? matches.allowed
    : status === "allowed" && state.allows_all_except_prohibited && !isUnverified(allowedFact)
      ? allowedFact.value
      : [];
const prohibitedFact = state.prohibited_foods;
const listNotes = compact([
  allowedItems.length > 0 ? factNotes(allowedFact) : null,
  matches.prohibited.length > 0 || status === "unclear" ? factNotes(prohibitedFact) : null,
]);

const specific = foodNotes(state, food);
const labelLines = foodLabelLines(state, food);
const canSell = status !== "prohibited";

const qas: QA[] = canSell
  ? [
      { q: `Do I need a permit to sell ${foodName} from home in ${state.name}?`, a: compact([permitStatement(state), agencyStatement(state)]) },
      { q: `How much does a ${state.name} cottage food license cost?`, a: compact([costStatement(state)]) },
      { q: `Is there a limit on how much I can sell in ${state.name}?`, a: capStatements(state) },
      { q: `Where can I sell ${foodName} in ${state.name}?`, a: compact([channelStatement(state), channelNotes(state)]) },
      { q: `Do I need training or a kitchen inspection in ${state.name}?`, a: compact([trainingStatement(state), inspectionStatement(state)]) },
    ]
  : [];

const otherFoods = FOODS.filter((f) => f.slug !== food.slug).map((f) => ({ food: f, status: statusForFood(state, f) }));
const sellable = otherFoods.filter((o) => o.status === "allowed" || o.status === "restricted");
const labeling = state.labeling_requirements;
---
<Layout>
  <Seo
    slot="head"
    title={`Can I sell ${foodName} from home in ${state.name}? ${STATUS_ANSWER[status]}`}
    description={`${STATUS_ANSWER[status]}. ${shortAnswer} ${rules}`.trim()}
    path={`/guides/sell/${food.slug}/${state.slug}/`}
    crumb={`Selling ${foodName} in ${state.name}`}
    ogType="article"
  />

  <article class="container-prose py-10">
    <p class="citation">Guide · Selling from home</p>
    <h1 class="font-serif text-3xl md:text-4xl">
      Can I sell {foodName} from home in {state.name}?
    </h1>
    <div class="mt-3"><Disclaimer /></div>

    <p class="mt-6 text-lg leading-relaxed">{headline}</p>
    <p class="mt-2 text-sm text-muted-foreground">{statusBasis}</p>
    {override && <CitedList items={[override]} />}

    {(allowedItems.length > 0 || matches.prohibited.length > 0) && (
      <section class="mt-10">
        <h2 class="font-serif text-2xl">What {state.name}'s food lists say about {foodName}</h2>

        {allowedItems.length > 0 && !isUnverified(allowedFact) && (
          <div class="mt-4">
            <h3 class="font-serif text-lg">{matches.allowed.length > 0 ? "On the allowed list" : "Allowed foods rule"}</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {allowedItems.map((item) => <li>{item}</li>)}
            </ul>
            <p class="mt-1"><Cite cite={allowedFact} /></p>
          </div>
        )}

        {matches.prohibited.length > 0 && !isUnverified(prohibitedFact) && (
          <div class="mt-6">
            <h3 class="font-serif text-lg">On the prohibited list</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {matches.prohibited.map((item) => <li>{item}</li>)}
            </ul>
            <p class="mt-1"><Cite cite={prohibitedFact} /></p>
          </div>
        )}

        {listNotes.length > 0 && (
          <div class="mt-6">
            <h3 class="font-serif text-lg">How {state.name} reads its lists</h3>
            <CitedList items={listNotes} />
          </div>
        )}
      </section>
    )}

    {specific.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-2xl">Other {state.name} rules that name {foodName}</h2>
        <CitedList items={specific} />
      </section>
    )}

    <QaSection heading={`Selling ${foodName} in ${state.name}: permit, cost, and where to sell`} qas={qas} />

    {canSell && !isUnverified(labeling) && (
      <section class="mt-10">
        <h2 class="font-serif text-2xl">Labeling {foodName} in {state.name}</h2>
        <p class="mt-3">
          {state.name}'s cited labeling rules list {labeling.value.length} requirements{labelLines.length > 0 ? `, including ${labelLines.length === 1 ? "one" : "these"} that name${labelLines.length === 1 ? "s" : ""} ${foodName}` : ""}.
          The full list is in the <a href={`/guides/labeling/${state.slug}/`}>{state.name} labeling guide</a>.
        </p>
        {labelLines.length > 0 && (
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {labelLines.map((l) => <li>{l}</li>)}
          </ul>
        )}
        <p class="mt-1"><Cite cite={labeling} /></p>
      </section>
    )}

    <section class="mt-10">
      <h2 class="font-serif text-2xl">Other foods in {state.name}</h2>
      {!canSell && sellable.length > 0 && (
        <p class="mt-3">
          {state.name}'s lists do allow {sellable.map((o) => o.food.name.toLowerCase()).join(", ")}, at least in part.
        </p>
      )}
      <ul class="mt-3 grid grid-cols-1 gap-2 text-sm md:grid-cols-2">
        {otherFoods.map((o) => (
          <li>
            <a href={`/guides/sell/${o.food.slug}/${state.slug}/`}>Selling {o.food.name.toLowerCase()} in {state.name}</a>{" "}
            <span class="citation">· {STATUS_ANSWER[o.status]}</span>
          </li>
        ))}
      </ul>
    </section>

    <nav class="double-rule mt-10 pt-6 text-sm" aria-label="Related">
      <ul class="space-y-1">
        <li>All {state.name} rules: <a href={`/states/${state.slug}/`}>{state.name} cottage food law</a></li>
        <li>{food.name} in every state: <a href={`/foods/${food.slug}/`}>{food.name} by state</a></li>
        <li>Fees: <a href={`/guides/license-cost/${state.slug}/`}>{state.name} cottage food license cost</a></li>
        <li>All guides: <a href="/guides/">Cottage food guides</a></li>
      </ul>
    </nav>
  </article>
</Layout>
