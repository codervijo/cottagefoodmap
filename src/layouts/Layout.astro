---
import "../styles/global.css";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="author" content="Cottage Food Law /US" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cottage Food Law /US" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Cottage Food Law /US",
      description: "Structured, sourced reference to U.S. cottage food laws.",
    })} />
    <slot name="head" />
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-rule bg-background">
        <div class="container-prose flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between md:py-5">
          <a href="/" class="no-underline">
            <div class="font-serif text-xl font-semibold text-foreground">
              Cottage Food Law <span class="text-primary">/US</span>
            </div>
            <div class="citation mt-0.5">A structured reference to state cottage food rules</div>
          </a>
          <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <a href="/states/" class="text-foreground no-underline hover:underline">States</a>
            <a href="/compare/" class="text-foreground no-underline hover:underline">Compare</a>
            <a href="/foods/" class="text-foreground no-underline hover:underline">Foods</a>
            <a href="/guides/" class="text-foreground no-underline hover:underline">Guides</a>
            <a href="/about/" class="text-foreground no-underline hover:underline">About</a>
          </nav>
        </div>
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="mt-16 border-t border-rule bg-muted/40">
        <div class="container-prose py-8 text-sm text-muted-foreground">
          <p class="font-serif text-base text-foreground">
            Informational reference only — not legal advice.
          </p>
          <p class="mt-2 max-w-3xl">
            Cottage food laws change frequently and are administered differently at the local level.
            Always consult the official agency cited on each page, and confirm requirements with your
            state or county before selling food. Last reviewed dates are shown on every fact.
          </p>
          <p class="citation mt-4">© {year} Cottage Food Law /US</p>
        </div>
      </footer>
    </div>
  </body>
</html>
